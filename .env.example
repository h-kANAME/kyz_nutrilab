# Public origin (CORS + cookie Secure context)
PUBLIC_ORIGIN=http://localhost:8088

# Google Identity Services — Client ID only (no client secret)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated allowlist. Use * only in local/dev.
ALLOWED_GOOGLE_EMAILS=*

# Session JWT (min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32

# LLM (default de servidor; cada usuario puede elegir otro en Ajustes)
LLM_PROVIDER=openai
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Optional model overrides
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_MODEL=deepseek-chat

# Storage (inside containers)
SQLITE_PATH=/data/nutrilab.db
UPLOAD_DIR=/data/uploads

# API
API_PORT=8080
NODE_ENV=development
COOKIE_NAME=nutrilab_session

# Web Push (Android Chrome / PWA). Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kyz-apps.site
